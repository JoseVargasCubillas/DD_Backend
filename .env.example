# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dd_platform
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Drive import
# API key con Google Drive API habilitada. La carpeta a importar debe estar compartida.
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# Grupos de WhatsApp de Academia (Business/Master) — el link real nunca se
# manda por correo, se manda un link propio de un solo uso que redirige aqui.
WHATSAPP_GROUP_BUSINESS_URL=https://chat.whatsapp.com/xxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_GROUP_MASTER_URL=https://chat.whatsapp.com/xxxxxxxxxxxxxxxxxxxxxx

# Nodemailer (Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu@email.com
MAIL_PASS=your_app_password
MAIL_FROM="Diego Díaz <no-reply@diegodiaz.mx>"

# WhatsApp bulk (Whapi.cloud - comparte token con Consultoria_backend)
WHAPI_TOKEN=
WHAPI_URL=https://gate.whapi.cloud

# Boletos QR de eventos
# Secreto para firmar los folios del QR (si falta se usa JWT_SECRET).
TICKET_QR_SECRET=
# Google Sheet de control de asistencia (una pestaña por evento). Compartir
# como Editor con el client_email de GOOGLE_SA_KEY_FILE. Vacío = desactivado.
ATTENDANCE_SHEET_ID=
GOOGLE_SA_KEY_FILE=/var/www/dd-academia-backend/google-sa.json

# HubSpot -> boletos QR (polling de negocios ganados, ver hubspot.service.ts)
# Private App con scopes de lectura: crm.objects.deals, contacts, line_items, products.
# Vacío = el worker queda desactivado.
HUBSPOT_TOKEN=
HUBSPOT_SYNC_ENABLED=true
HUBSPOT_PIPELINE_ID=default
HUBSPOT_WON_STAGE_ID=closedwon
HUBSPOT_POLL_INTERVAL_SEC=300
# Propiedad del objeto Producto con Presencial/Online (opcional; también se lee la descripción).
HUBSPOT_PRODUCT_MODALITY_PROPERTY=modalidad
# Corte: no se procesan negocios modificados antes de esta fecha ISO. Vacío = desde el primer arranque.
HUBSPOT_SYNC_START=
# Grupos de WhatsApp de los eventos online (uno por producto). Vacío = ese producto no manda
# el bloque "Únete al grupo" y, desde HubSpot, queda pendiente hasta que se configure.
WHATSAPP_GROUP_HOLDING_URL=
WHATSAPP_GROUP_SEF_ONLINE_URL=
# Equivalencias producto HubSpot -> fragmento del slug/título del evento en la DB, separadas por ";".
# Ya vienen por defecto SEF CDMX / SEF MTY / SEF GDL; aquí solo agrega más (ej. "Rockefeller=codigo-rockefeller").
HUBSPOT_EVENT_ALIASES=
